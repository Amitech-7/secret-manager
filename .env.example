# Names only. Never commit real values. Real values live in Vercel (Production / Preview),
# in GitHub Actions secrets, and in a local .env.local that git ignores.

# --- apps/api ---
DATABASE_URL=            # restricted role sm_app, pooled host (-pooler), sslmode=verify-full
CRON_SECRET=             # 32+ random characters; Vercel Cron sends it automatically
RATE_LIMIT_SECRET=       # 32+ random characters; keys the hashed IP / username counters
JWT_SECRET=              # 32+ random characters; signs 15-minute access tokens
FAKE_SALT_SECRET=        # 32+ random characters; makes unknown usernames look real
TURNSTILE_SECRET=        # Cloudflare Turnstile secret key. Registration is refused without it.
TOTP_ENC_KEY=            # 32 random bytes as base64url, 43 characters (used from M7)
ALLOWED_ORIGINS=         # comma-separated, e.g. capacitor://localhost,https://localhost (M10)
DB_SIZE_LIMIT_MB=512     # optional; free-tier limit used by the size alert

# --- apps/web (public, compiled into the page at build time) ---
VITE_API_URL=            # empty on the web (same origin); set for the mobile build
VITE_TURNSTILE_SITE_KEY= # Cloudflare Turnstile site key (public)
VITE_CONTACT_EMAIL=      # optional; shows a Contact Us link to signed-in users

# Local development: Cloudflare publishes always-pass test keys for Turnstile
# (see "Testing" in Cloudflare's Turnstile docs): use those instead of real ones.
