# Names only. Never commit real values. Real values live in Vercel (Production / Preview),
# in GitHub Actions secrets, and in a local .env.local that git ignores.

# --- apps/api (required now) ---
DATABASE_URL=            # restricted role sm_app, pooled host (-pooler)
CRON_SECRET=             # 32+ random characters; Vercel Cron sends it automatically
RATE_LIMIT_SECRET=       # 32+ random characters; keys the hashed IP / username counters

# --- apps/api (used from later milestones) ---
JWT_SECRET=              # 32+ random characters (M3)
FAKE_SALT_SECRET=        # 32+ random characters (M3)
TOTP_ENC_KEY=            # 32 random bytes as base64url, 43 characters (M7)
TURNSTILE_SECRET=        # Cloudflare Turnstile secret key (M3)
ALLOWED_ORIGINS=         # comma-separated, e.g. capacitor://localhost,https://localhost (M10)
DB_SIZE_LIMIT_MB=512     # optional; free-tier limit used by the size alert

# --- apps/web ---
VITE_API_URL=            # empty on the web (same origin); set for the mobile build
